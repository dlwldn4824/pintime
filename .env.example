# 친구 공유 링크에 쓸 배포 웹 주소 (짧고 고정). 비우면 https://pintime.vercel.app
VITE_PUBLIC_WEB_URL=https://pintime.vercel.app

# 웹 익명 이벤트 수신 URL (선택). 없으면 동의해도 네트워크 전송 안 함.
VITE_ANALYTICS_URL=

# ── Firebase (회원가입 · 캘린더/할 일 클라우드) ─────────────────
# 1) https://console.firebase.google.com/ 프로젝트 생성
# 2) Authentication → Sign-in method → Email/Password 사용 설정
# 3) Firestore Database 생성 후 firestore.rules 배포
# 4) 프로젝트 설정 → 내 앱 → 웹 앱 추가 → SDK 설정 값을 아래에 붙여넣기
# 5) .env.local 에 저장 후 `npm run dev` 재시작
#
# 승인된 도메인에 localhost, 127.0.0.1, pintime.vercel.app 추가
# (데스크톱 앱은 127.0.0.1 사용 — 없으면 Google 로그인 실패)
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
